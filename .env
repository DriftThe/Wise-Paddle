# ─── Wise-Paddle 当前生效配置 ────────────────────────────────────
# 见 .env.example 完整列表（每个参数都带单位 / 区间 / 默认值 / 调参影响）
# 任何不填 / 删掉的行都用代码里的默认值；改完保存，重启服务生效


# ─── HTTP 服务 ────────────────────────────────────────────────────
# HOST: 监听地址。127.0.0.1=仅本机；0.0.0.0=所有网卡（部署/反代用）。默认 127.0.0.1
HOST=127.0.0.1
# PORT: HTTP 端口。1024-65535 任选，避开已占用端口。默认 8000
PORT=8000
# GRACEFUL_SHUTDOWN_S: Ctrl+C / SIGTERM 后给 worker 多少秒收尾。>0 的整数。默认 15
GRACEFUL_SHUTDOWN_S=15
# CORS_ALLOW_ORIGINS: 允许的跨域来源，逗号分隔；* = 全部。生产改成你的域名
CORS_ALLOW_ORIGINS=http://localhost:*,http://127.0.0.1:*


# ─── 模型路径 ──────────────────────────────────────────────────────
# LAYOUT_MODEL_PATH: PP-DocLayoutV3 权重目录。绝对路径或相对项目根
LAYOUT_MODEL_PATH=./model/PP-DocLayoutV3
# VL_MODEL_PATH: PaddleOCR-VL-1.6 权重目录。绝对路径或相对项目根
VL_MODEL_PATH=./model/PaddleOCR-VL-1.6
# OUTPUT_DIR: OCR 产物根目录（按 request_id 自动分子目录；不写就落这里）
OUTPUT_DIR=./text_result


# ─── 调度器（影响吞吐 / 并发）──────────────────────────────────────
# PIPELINE_POOL_SIZE: 几辆 pipeline 卡车。1=串行；2=2 路并发。
# 显存占用 ≈ PIPELINE_POOL_SIZE × 单模型显存（RTX 4060 8GB 默认 2 约 7.6GB）。
# 需要快且显存足够就调高。整数 ≥ 1。默认 2
PIPELINE_POOL_SIZE=1
# BATCH_MAX: 单次 batch 最多几页（=几次 layout + VL forward 的子批大小）。
# 大=吞吐高但单 user 等待久；小=响应快但 GPU 利用率低。1-10。默认 5
BATCH_MAX=10
# BATCH_FLUSH_MS: worker 凑批等多久（毫秒）。小=响应快但批小；大=批大但用户等。
# 100-1000 之间试。默认 250
BATCH_FLUSH_MS=250

# ─── 精度：Layout 检测 ─────────────────────────────────────────────
# LAYOUT_SCORE_THRESHOLD: PP-DocLayoutV3 初次过滤置信度门槛。0.0-1.0。
# 高→漏检但准；低→多框但有噪声。doclayout 框偏小时尤其注意。默认 0.5
LAYOUT_SCORE_THRESHOLD=0.3


# ─── 精度：Box 过滤 + unclip───────────────────────────────
# BOX_IOU_THRESHOLD: NMS 重叠上限。0.0-1.0。越大越激进去重。默认 0.5
BOX_IOU_THRESHOLD=0.5
# BOX_MIN_BOX_AREA: 最小框面积（像素²）。小于此值的框直接舍弃。整数 ≥ 1。默认 256
BOX_MIN_BOX_AREA=256
# BOX_MIN_SCORE: BoxFilter 二次过滤置信度。0.0-1.0。建议 = LAYOUT_SCORE_THRESHOLD。默认 0.5
BOX_MIN_SCORE=0.3
# BOX_UNCLIP_RATIO: NMS 后把框向外扩的比例（0.05 = 每边向外扩 5%）。
# 0=不扩充检测框；0.05~0.10 通常让 VL 看到更多上下文，准确率明显提升。
# doclayout 检测框偏小时可以调高。0.0-0.5。默认 0.05
BOX_UNCLIP_RATIO=0.03
# BOX_EXPAND_PIXELS: 每边再多扩 N 个像素（绝对值）。和 ratio 叠加生效。整数 ≥ 0。默认 4
BOX_EXPAND_PIXELS=2


# ─── 精度：VL 识别 ───────────────────────────────────────────────
# VL_MIN_PIXELS: 图像最短边像素下限（<此值会上采样到此目标）。
# 112896 = 336×336 基准。调大→细节更好；调小→速度更快。整数 ≥ 1。默认 112896
VL_MIN_PIXELS=112896
# VL_MAX_PIXELS: 图像最长边像素上限（>此值会下采样到此目标）。
# 1003520 ≈ 1280×28×28 官方上限。调大→细节更好；调小→速度更快。整数 ≥ 1。默认 1003520
VL_MAX_PIXELS=1003520
# VL_REPETITION_PENALTY: 防重复循环（>1.0）。官方默认 1.0，batch 时容易陷入重复；
# 1.15 经验值。要"更确定"调 1.0，要"更活"调 1.3。≥ 1.0。默认 1.15
VL_REPETITION_PENALTY=1.15
# VL_DO_SAMPLE: false=greedy 确定输出；true=按概率采样，可能导致不稳定。true/false。默认 false
VL_DO_SAMPLE=false


# ─── 速度 / 显存：VL 推理 ─────────────────────────────────────────
# VL_MAX_FORWARD_BATCH: 单次 VL forward 最多 image(regions) 数（显存硬上限）。
VL_MAX_FORWARD_BATCH=8
# VL_MAX_NEW_TOKENS: 单张图最多生成多少 token（per region）。太大拖慢 + 显存高。整数 ≥ 1。默认 256
VL_MAX_NEW_TOKENS=256
# ATTN_IMPL: sdpa（快、显存低，推荐）| eager（兼容性更好，老硬件 fallback）。默认 sdpa
ATTN_IMPL=sdpa
# DTYPE: bfloat16（推荐，数值稳定）| float16（省显存但易溢出）| float32（更高的显存消耗）。默认 bfloat16
DTYPE=bfloat16
# MAX_REGIONS: 单页最多送 VL 的 region 数（按分数截断）。100=几乎不限制。整数 ≥ 1。默认 100
MAX_REGIONS=100


# ─── 资源保护 ────────────────────────────────────────────────────
# MAX_IMAGE_UPLOAD_MB: 单图上传大小上限（MB）。超过返回 413。整数 ≥ 1。默认 32
MAX_IMAGE_UPLOAD_MB=32
# MAX_PDF_UPLOAD_MB: 单 PDF 上传大小上限（MB）。超过返回 413。整数 ≥ 1。默认 128
MAX_PDF_UPLOAD_MB=128
# MAX_PDF_PAGES: 单 PDF 页数上限。超过返回 413。整数 ≥ 1。默认 200
MAX_PDF_PAGES=200
# PDF_DPI: PDF 转 PNG 分辨率。200=默认；300=更清晰但慢。整数 ≥ 72。默认 200
PDF_DPI=200


# ─── 日志 ──────────────────────────────────────────────────────────
# LOG_DIR: 日志目录（按天分文件：server-YYYY-MM-DD.log）
LOG_DIR=./logs
# LOG_KEEP_DAYS: 启动时清理 N 天前的旧 log 文件；0=不清。整数 ≥ 0。默认 14
LOG_KEEP_DAYS=14
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR。默认 INFO
LOG_LEVEL=INFO


# ─── 清理 ──────────────────────────────────────────────────────────
# PDF_PROGRESS_TTL_S: _pdf_progress_store 进度条目保留秒数（前端能轮询多久）。整数 ≥ 1。默认 600
PDF_PROGRESS_TTL_S=600
# TEXT_RESULT_KEEP_DAYS: text_result/<request_id>/ 子目录保留天数。0=不清；建议 7~30。整数 ≥ 0。默认 0
TEXT_RESULT_KEEP_DAYS=0
# CLEANUP_INTERVAL_S: text_result 清理循环间隔秒。整数 ≥ 1。默认 300
CLEANUP_INTERVAL_S=300
